      ],
      "facts": {
        "question": "When does a Hacking Device Firewall apply to incoming Comms Attacks?",
        "answer": "The Firewall MODs apply to Comms Attacks against the Trooper while the Hacking Device is operational. They do not apply while that Device is disabled, including when the Trooper is Isolated or in any Null State.",
        "topicIds": [
          "equipment:hacking-device",
