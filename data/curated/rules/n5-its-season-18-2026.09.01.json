          "rules": [
            {
              "id": "sectors",
              "name": "Sectors (ZO)",
              "paragraphs": [
                "Three Sectors are identified only when the game has finished, not before. Each is a Zone of Operations spanning the table width. The central Sector straddles the table centre; the other two are on opposite sides.",
                "In 150-point games, each Sector is [[distance:4:inch]] deep, with the outer Sectors positioned [[distance:2:inch]] from the central line. In 200-400-point games, each Sector is [[distance:8:inch]] deep, with the outer Sectors positioned [[distance:4:inch]] from the central line.",
                "The displayed map locates the end-of-game scoring areas for reference; it does not instruct players to mark the areas before the game ends."
              ]
            },
            {
              "id": "dominate-zo",
              "name": "Dominate a Zone of Operations",
              "paragraphs": [
                "A player Dominates a Sector when they have more Victory Points of eligible Troopers inside it than their opponent. Models, Trooper Markers, Proxies and [[skill:peripheral|Peripheral]] Troops count; Troopers in a Null [[trait:state|State]], equipment Tokens and fake Holoechoes do not.",
                "More than half of a Trooper's base must lie inside the Sector for it to count toward Dominating that Zone of Operations."
              ]
            },
            {
              "id": "shasvastii",
              "name": "Embryo eligibility",
              "paragraphs": [
                "Troopers possessing [[skill:shasvastii|Shasvastii]] count toward Domination while in [[state:unconscious|Unconscious]] or any non-Null [[trait:state|State]]."
              ]
            },
            {
              "id": "baggage",
              "name": "Bonus for equipped Troopers",
              "paragraphs": [
                "[[equipment:baggage|Baggage]] grants an additional 20 Victory Points toward Dominating the Sector when its Trooper is inside that Sector and is in a non-Null [[trait:state|State]]."
              ]
            },
            {
              "id": "killing",
              "name": "Killing",
              "paragraphs": [
                "Troopers count as Killed if they enter [[state:dead|Dead State]], are in a Null [[trait:state|State]] when the game ends, or were not deployed on the table as a Model or Marker by the end of the game."
              ]
            },
            {
              "id": "hvt-and-classified-deck",
              "name": "HVT and Classified Deck not used",
              "paragraphs": [
                "Players do not deploy an HVT Model or use the Classified Deck. The Secure HVT rule does not apply."
              ]
            }
          ],
