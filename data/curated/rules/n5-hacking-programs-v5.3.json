        {
            "id": "hacking-program:controlled-jump",
            "kind": "hacking-program",
            "name": "Controlled Jump",
            "summary": "Supportware that takes effect immediately, modifying [[skill:combat-jump]] PH Rolls across the table; opposing instances cancel each other's effects.",
            "composition": {
                "role": "definition"
            },
            "scope": {
                "game": "N5",
                "seasons": [
                    "current"
                ]
            },
            "facts": {
                "effects": [
                    "This Program takes effect as soon as it is declared, before the Resolution step; place its Supportware Token beside the [[skill:hacker]].",
                    "While active, allied Troopers receive +3 and enemy Troopers receive -3 on [[skill:combat-jump]] PH Rolls anywhere on the table, even if the Troopers are not Hackable.",
                    "A [[skill:hacker]] can declare this Program as an ARO against an enemy [[skill:combat-jump]] anywhere on the table. Its -3 MOD immediately applies to the same [[skill:combat-jump]] PH Roll."
                ],
                "restrictions": [
                    "Declaring this Program as an ARO is optional; the [[skill:hacker]] may declare another eligible ARO instead.",
                    "If both players have this Program active, their Programs' effects cancel. This does not cancel independent MODs, such as Firefight's Designated Landing Area +3.",
                    "A player cannot have more than one Controlled Jump Program active.",
                    "This Program does not affect Speedball Tokens placed with [[skill:request-speedball]], even though their placement uses [[skill:combat-jump]] rules. The FAQ limits this Program to Troopers."
                ]
            },
            "relations": [
                {
                    "type": "modifies-rolls-for",
                    "recordId": "skill:combat-jump"
                }
            ],
