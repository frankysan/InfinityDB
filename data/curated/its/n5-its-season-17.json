    {
      "id": "skill:casevac",
      "kind": "skill",
      "name": "Casevac",
      "summary": "ITS 17 Optional Common Short Movement Skill: carry an allied Stunned, Immobilized or Unconscious Trooper.",
      "composition": {
        "role": "definition"
      },
      "scope": {
        "game": "N5",
        "seasons": [
          "its-17"
        ]
      },
      "facts": {
        "category": "common-skill",
        "typeIds": [
          "short-movement-skill"
        ],
        "requirements": [
          "Only Models may use Casevac. Declaring Casevac reveals any Marker.",
          "The carrier must be in Silhouette contact with an allied Trooper in Stunned, Immobilized (IMM-A or IMM-B) or Unconscious State, unless a Scenario Special Rule modifies this.",
          "The carrier must have PH equal to or greater than the carried Trooper's PH; Baggage removes this requirement."
        ],
        "effects": [
          "Casevac activates [[state:casevac|Casevac State]] for the carrier and the carried allied Trooper. Its movement, ARO and cancellation rules are defined by that State."
        ],
        "restrictions": [
          "A carried Trooper cannot declare or perform its own Orders or AROs while [[state:casevac|Casevac State]] applies."
        ],
        "applicability": {
          "context": "season",
          "revision": "0.2"
        }
      },
