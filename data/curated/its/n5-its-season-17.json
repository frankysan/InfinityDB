    {
      "id": "state:casevac",
      "kind": "state",
      "name": "Casevac State",
      "aliases": [
        "Casevac"
      ],
      "summary": "ITS 17 State entered through [[skill:casevac|Casevac]]: a carrier moves an allied Stunned, Immobilized or Unconscious Trooper in Silhouette contact.",
      "composition": {
        "role": "definition"
      },
      "scope": {
        "game": "N5",
        "seasons": [
          "its-17"
        ]
      },
      "facts": {
        "category": "state",
        "requirements": [
          "Activate this State with [[skill:casevac|Casevac]] while in Silhouette contact with an allied Trooper in Stunned, Immobilized (IMM-A or IMM-B) or Unconscious State. The carrier needs PH at least equal to the target's PH, except when Baggage waives it; Scenario Special Rules may modify the target requirement."
        ],
        "effects": [
          "The carrier and carried Trooper activate together with one Order or ARO and move simultaneously in Silhouette contact, using the carrier's MOV values.",
          "The carried Trooper cannot declare or perform Orders or AROs; only the carrier does so.",
          "Together, both Troopers provoke only one ARO from each eligible enemy within LoF or ZoC.",
          "Template Weapon Attacks against either Trooper use the Template Weapons Into Close Combat rule.",
          "The carried Trooper does not block LoF and does not contribute the +1 B MOD in Close Combat.",
          "Casevac State automatically ends if the carrier declares any Skill other than Cautious Movement, Climb, Dodge, Jump, Reset or a Short Movement Skill.",
          "It also ends if the carrier is activated in the Impetuous Phase, enters an Immobilized or Null State or another canceling State, or becomes a Marker (including Camouflaged, Impersonation or Holoecho).",
          "It ends when the carried Trooper recovers from Immobilized (IMM-A or IMM-B), Stunned or Unconscious State.",
          "The carrier may end it voluntarily by spending a Short Skill of an Order, without a Roll."
        ],
        "restrictions": [
          "Unless a Scenario Special Rule states otherwise, a carrier may carry at most one Immobilized, Stunned or Unconscious Trooper."
        ],
        "applicability": {
          "context": "season",
          "revision": "0.2"
        }
      },
