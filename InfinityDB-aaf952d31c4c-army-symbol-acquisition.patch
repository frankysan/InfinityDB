-
-    tail = url.removeprefix(f"https://{ASSET_HOST}{ASSET_PATH}")
-    tail = tail.split("#", 1)[0]
-    if ".svg" in tail.lower():
-        stem = tail[: tail.lower().rfind(".svg")]
-        name = f"{stem}.svg"
-    else:
-        name = Path(parsed.path).name
-
-    if not SVG_NAME.fullmatch(name):
-        name = sanitize_filename(name)
-    return name
