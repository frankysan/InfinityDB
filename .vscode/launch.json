{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Infinity: Build database",
      "type": "debugpy",
      "request": "launch",
      "module": "infinity_db",
      "args": [
        "build",
        "${workspaceFolder}/data/raw/JSON 20260909.zip",
        "--output-dir",
        "${workspaceFolder}/data/generated",
        "--compact"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Infinity: Serve web UI",
      "type": "debugpy",
      "request": "launch",
      "module": "infinity_db",
      "args": ["serve"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
