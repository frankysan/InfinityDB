{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Infinity: Build database",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "infinity_db",
        "build",
        "--output-dir",
        "${workspaceFolder}/data/generated",
        "--compact"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Infinity: Serve web UI",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "infinity_db", "serve"],
      "problemMatcher": []
    },
    {
      "label": "Python: Tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["tools/run_checks.py", "--stage", "test"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Python: Type check",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["tools/run_checks.py", "--stage", "type"],
      "problemMatcher": []
    },
    {
      "label": "Python: Ruff",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["tools/run_checks.py", "--stage", "lint"],
      "problemMatcher": []
    }
  ]
}
