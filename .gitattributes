# Auto detect text files and perform LF normalization
* text=auto

# Processed Corvus Belli symbol publications are byte-exact, checksum-bound assets.
# Treat them as binary so Git never rewrites line endings across platforms.
src/infinity_db/web/static/armies/** binary
src/infinity_db/web/static/characteristics/** binary
src/infinity_db/web/static/orders/** binary
src/infinity_db/web/static/units/** binary

# Manifest-bound publication metadata is also byte-exact release content.
src/infinity_db/web/static/symbol-inventory.json binary
src/infinity_db/web/static/army-symbols.js binary
src/infinity_db/web/static/unit-symbol-map.js binary
