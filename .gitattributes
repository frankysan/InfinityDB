# Keep repository-managed text bytes LF on every supported platform.
* text=auto eol=lf

# Processed Corvus Belli symbol publications are byte-exact, checksum-bound assets.
# Treat them as binary so Git never rewrites line endings across platforms.
src/infinity_db/web/static/armies/** binary
src/infinity_db/web/static/characteristics/** binary
src/infinity_db/web/static/orders/** binary
src/infinity_db/web/static/units/** binary

# Runtime SQLite databases are byte-deterministic release artifacts.
data/generated/infinity.db binary
data/generated/rules.db binary
# Byte-exact derived publication, tied to the reviewed raw archive and runtime pair.
data/generated/variant-usage.json binary
